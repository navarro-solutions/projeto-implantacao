# ID da planilha: é o trecho entre /d/ e /edit no link
# https://docs.google.com/spreadsheets/d/ESTE_TRECHO/edit
# Sem esta variável o painel mostra dados de exemplo.
GOOGLE_SHEET_ID=

# Opção A (mais simples): compartilhe a planilha como "Qualquer pessoa com o link: Leitor".
#   Não precisa de mais nada.
#
# Opção B (recomendada para dados financeiros): planilha privada, lida por uma conta de serviço.
#   Compartilhe a planilha com o e-mail abaixo (permissão Leitor).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave privada do JSON da conta de serviço, com os \n, entre aspas.
GOOGLE_PRIVATE_KEY=

# Nomes das abas (só mude se renomear na planilha)
# ABA_CLIENTES=Clientes
# ABA_IMPLANTACOES=Implantacoes
# ABA_LANCAMENTOS=Lancamentos
# ABA_ECONOMIAS=Economias

# Senha para forçar atualização na hora: /api/revalidar?token=...
REVALIDATE_TOKEN=
